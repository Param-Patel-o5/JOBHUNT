# =========================================================================
# JobHunt OS Environment Configuration
# =========================================================================

# Search & OSINT Dorking Engine (Tavily Search API)
# Fallback to DuckDuckGo search is automatic if key is omitted or quota is hit.
TAVILY_API_KEY=your_tavily_api_key_here

# Google AI Studio API Keys (Multi-Account Round-Robin Pool)
# Supply multiple keys separated by commas to cycle quotas (15 RPM / 500 RPD per key)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Primary Fallback Google AI Studio Key
GOOGLE_API_KEY=your_primary_gemini_key_here
